# Version control
.git
.gitignore

# Environment variables & secrets (NEVER bake API keys into images!)
.env
.env.*
!.env.example

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Large local Vector Database & cache (mounted via volume instead of baking into image)
data/chroma_db/
.cache/
~/.cache/

# Scanned raw image dataset (not needed for API runtime; chunks.json is used)
Dataset/

# Execution logs & outputs
*.log
output_*.txt
output_transcribe_notes.txt

# Editor & IDE configs
.vscode/
.idea/

# OS temporary files
.DS_Store
Thumbs.db
